# Copy to .env and fill in. .env is git-ignored. Repro reads only these
# variables; it never uses ANTHROPIC_API_KEY or ANTHROPIC_BASE_URL.
REPRO_ANTHROPIC_API_KEY=your-anthropic-api-key
REPRO_MODEL=your-model-id
# Optional: per-response output-token limit (default 8192).
# REPRO_MAX_OUTPUT_TOKENS=8192
